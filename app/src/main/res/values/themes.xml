<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色底（配绿色前景）；页背景保持浅色 -->
    <color name="ic_launcher_background">#0A0B0D</color>
    <color name="page_background">#F3F6FB</color>

    <style name="Theme.AiGateway" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!--
      系统提示框（Toast 之外的 AlertDialog）专用主题。

      不能直接用 android.app.AlertDialog 的默认主题：它继承 Activity 的
      Theme.Material.Light，于是深色界面正中弹出一块纯白方块，非常刺眼。
      这里改用深色 Material 主题，并配合 App 的金色主色画按钮，
      让系统对话框和整体视觉保持一致。

      windowBackground 用圆角深色 drawable，避免直角白块。
    -->
    <style name="Theme.AiGateway.Dialog" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_system_dialog</item>
        <item name="android:colorAccent">@color/dialog_accent</item>
        <item name="android:textColorPrimary">@color/dialog_text_primary</item>
        <item name="android:textColorSecondary">@color/dialog_text_secondary</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">false</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
